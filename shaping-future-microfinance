<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,Helvetica,sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#f5f7fb;
    color:#172033;
}

/* NAVBAR */
.navbar{
    position:sticky;
    top:0;
    z-index:1000;
    background:#ffffff;
    box-shadow:0 2px 15px rgba(0,0,0,.08);
}

.nav-container{
    max-width:1200px;
    margin:auto;
    padding:14px 20px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
}

.logo-box{
    width:48px;
    height:48px;
    border-radius:12px;
    background:linear-gradient(135deg,#0757b8,#13a4ff);
    display:flex;
    align-items:center;
    justify-content:center;
    color:white;
    font-size:20px;
    font-weight:bold;
}

.logo-text h2{
    font-size:18px;
    color:#0757b8;
}

.logo-text p{
    font-size:11px;
    color:#666;
}

.nav-links{
    display:flex;
    gap:25px;
    list-style:none;
}

.nav-links a{
    text-decoration:none;
    color:#333;
    font-size:14px;
    font-weight:600;
}

.nav-links a:hover{
    color:#0757b8;
}

.menu-btn{
    display:none;
    font-size:25px;
    cursor:pointer;
}

/* HERO */
.hero{
    min-height:610px;
    background:
    linear-gradient(120deg,rgba(5,47,102,.94),rgba(0,126,190,.84)),
    radial-gradient(circle at top right,#31b8ff,transparent 40%);
    color:white;
    display:flex;
    align-items:center;
}

.hero-container{
    width:1200px;
    max-width:92%;
    margin:auto;
    display:grid;
    grid-template-columns:1.2fr .8fr;
    gap:50px;
    align-items:center;
}

.hero h1{
    font-size:52px;
    line-height:1.1;
    margin-bottom:20px;
}

.hero h1 span{
    color:#7de0ff;
}

.hero p{
    font-size:18px;
    line-height:1.7;
    color:#e9f7ff;
    margin-bottom:30px;
}

.btn{
    display:inline-block;
    padding:14px 25px;
    border-radius:8px;
    text-decoration:none;
    font-weight:bold;
    margin-right:10px;
    transition:.3s;
}

.btn-primary{
    background:white;
    color:#0757b8;
}

.btn-primary:hover{
    transform:translateY(-2px);
}

.btn-outline{
    border:1px solid white;
    color:white;
}

.btn-outline:hover{
    background:white;
    color:#0757b8;
}

.hero-card{
    background:rgba(255,255,255,.12);
    backdrop-filter:blur(12px);
    border:1px solid rgba(255,255,255,.2);
    border-radius:20px;
    padding:30px;
}

.hero-card h3{
    font-size:24px;
    margin-bottom:20px;
}

.hero-stat{
    display:flex;
    justify-content:space-between;
    padding:15px 0;
    border-bottom:1px solid rgba(255,255,255,.2);
}

.hero-stat:last-child{
    border-bottom:none;
}

/* SECTION */
.section{
    padding:80px 20px;
}

.container{
    max-width:1200px;
    margin:auto;
}

.section-title{
    text-align:center;
    margin-bottom:50px;
}

.section-title h2{
    font-size:34px;
    color:#10244a;
    margin-bottom:10px;
}

.section-title p{
    color:#687386;
}

/* CARDS */
.cards{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.card{
    background:white;
    padding:30px;
    border-radius:16px;
    box-shadow:0 8px 30px rgba(24,53,92,.08);
    transition:.3s;
}

.card:hover{
    transform:translateY(-6px);
}

.icon{
    width:55px;
    height:55px;
    border-radius:13px;
    background:#e9f4ff;
    color:#0757b8;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:24px;
    margin-bottom:20px;
}

.card h3{
    margin-bottom:12px;
    color:#10244a;
}

.card p{
    color:#687386;
    line-height:1.6;
}

/* ABOUT */
.about{
    background:white;
}

.about-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:50px;
    align-items:center;
}

.about-box{
    padding:30px;
    background:#f4f8ff;
    border-left:5px solid #0757b8;
    border-radius:10px;
    line-height:1.8;
}

.check-list{
    list-style:none;
    margin-top:20px;
}

.check-list li{
    margin:12px 0;
    color:#4e5b6f;
}

.check-list li::before{
    content:"✓";
    color:#0a8f48;
    font-weight:bold;
    margin-right:10px;
}

/* PLANS */
.plans{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.plan{
    background:white;
    border-radius:16px;
    padding:30px;
    text-align:center;
    box-shadow:0 8px 30px rgba(24,53,92,.08);
}

.plan h3{
    color:#0757b8;
}

.plan .rate{
    font-size:38px;
    font-weight:bold;
    color:#10244a;
    margin:20px 0;
}

.plan p{
    color:#687386;
}

.note{
    text-align:center;
    margin-top:25px;
    color:#687386;
    font-size:13px;
}

/* LOGIN */
.login-section{
    background:#eef5fc;
}

.login-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.login-card{
    background:white;
    border-radius:18px;
    padding:30px;
    box-shadow:0 8px 30px rgba(24,53,92,.09);
}

.login-card h3{
    margin-bottom:8px;
    color:#10244a;
}

.login-card small{
    color:#778296;
}

.login-card form{
    margin-top:22px;
}

.input{
    width:100%;
    padding:13px 14px;
    border:1px solid #d8e0eb;
    border-radius:8px;
    margin-bottom:13px;
    outline:none;
}

.input:focus{
    border-color:#0757b8;
}

.login-btn{
    width:100%;
    padding:13px;
    border:none;
    background:#0757b8;
    color:white;
    border-radius:8px;
    cursor:pointer;
    font-weight:bold;
}

.login-btn:hover{
    background:#06468f;
}

.forgot{
    display:block;
    text-align:right;
    margin-top:10px;
    font-size:12px;
    color:#0757b8;
}

/* DASHBOARD */
.dashboard{
    background:#10244a;
    color:white;
}

.dashboard-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.dash-box{
    background:rgba(255,255,255,.1);
    padding:25px;
    border-radius:12px;
    border:1px solid rgba(255,255,255,.12);
}

.dash-box h3{
    font-size:28px;
    margin-bottom:5px;
}

.dash-box p{
    color:#c9d8ec;
}

/* CONTACT */
.contact-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:40px;
}

.contact-card{
    background:white;
    padding:30px;
    border-radius:15px;
    box-shadow:0 8px 30px rgba(24,53,92,.08);
}

.contact-item{
    margin:20px 0;
}

.contact-item strong{
    display:block;
    margin-bottom:5px;
    color:#10244a;
}

.contact-item a{
    color:#0757b8;
    text-decoration:none;
}

/* FOOTER */
footer{
    background:#07162f;
    color:#bfcce0;
    padding:45px 20px 20px;
}

.footer-grid{
    max-width:1200px;
    margin:auto;
    display:grid;
    grid-template-columns:2fr 1fr 1fr;
    gap:40px;
}

footer h3{
    color:white;
    margin-bottom:15px;
}

footer p{
    line-height:1.7;
    font-size:14px;
}

footer ul{
    list-style:none;
}

footer li{
    margin:10px 0;
}

footer a{
    color:#bfcce0;
    text-decoration:none;
}

.copyright{
    max-width:1200px;
    margin:30px auto 0;
    padding-top:20px;
    border-top:1px solid rgba(255,255,255,.1);
    text-align:center;
    font-size:12px;
}

/* MODAL */
.modal{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.65);
    z-index:2000;
    align-items:center;
    justify-content:center;
    padding:20px;
}

.modal-box{
    background:white;
    width:450px;
    max-width:100%;
    border-radius:18px;
    padding:30px;
    position:relative;
}

.close{
    position:absolute;
    right:20px;
    top:15px;
    font-size:25px;
    cursor:pointer;
    color:#555;
}

.modal-box h2{
    color:#10244a;
    margin-bottom:20px;
}

.modal-message{
    margin-top:15px;
    text-align:center;
    font-size:13px;
}

/* RESPONSIVE */
@media(max-width:900px){

    .nav-links{
        display:none;
        position:absolute;
        top:76px;
        left:0;
        right:0;
        background:white;
        flex-direction:column;
        padding:20px;
    }

    .nav-links.active{
        display:flex;
    }

    .menu-btn{
        display:block;
    }

    .hero-container,
    .about-grid,
    .contact-grid{
