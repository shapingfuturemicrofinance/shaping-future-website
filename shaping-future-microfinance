<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Shaping Future Microfinance Pvt. Ltd.</title>

  <meta name="description"
        content="Shaping Future Microfinance Pvt. Ltd. - SHG services, financial awareness, career opportunities and customer support.">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    :root {
      --primary: #073b75;
      --secondary: #0879d9;
      --light: #f3f7fc;
      --dark: #172b45;
      --white: #ffffff;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: var(--dark);
      line-height: 1.6;
      background: var(--white);
    }

    header {
      background: var(--white);
      padding: 14px 6%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      box-shadow: 0 2px 12px #00000012;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .logo {
      color: var(--primary);
      font-size: 21px;
      font-weight: bold;
    }

    .logo small {
      display: block;
      font-size: 11px;
      color: #52677e;
      letter-spacing: 1px;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 15px;
    }

    nav a {
      color: var(--dark);
      text-decoration: none;
      font-size: 14px;
      font-weight: bold;
    }

    nav a:hover {
      color: var(--secondary);
    }

    .lang-btn, .btn {
      border: none;
      cursor: pointer;
      border-radius: 6px;
      padding: 11px 17px;
      font-weight: bold;
      text-decoration: none;
      display: inline-block;
    }

    .lang-btn {
      background: #e7f1ff;
      color: var(--primary);
    }

    .btn-primary {
      background: var(--secondary);
      color: var(--white);
    }

    .btn-light {
      background: var(--white);
      color: var(--primary);
    }

    .hero {
      padding: 90px 8%;
      background: linear-gradient(120deg, #073b75, #0879d9);
      color: var(--white);
      min-height: 430px;
      display: flex;
      align-items: center;
    }

    .hero-content {
      max-width: 800px;
    }

    .hero h1 {
      font-size: clamp(32px, 5vw, 53px);
      line-height: 1.2;
      margin-bottom: 20px;
    }

    .hero p {
      font-size: 18px;
      margin-bottom: 28px;
      max-width: 680px;
    }

    section {
      padding: 65px 7%;
      scroll-margin-top: 95px;
    }

    .section-title {
      text-align: center;
      color: var(--primary);
      font-size: 31px;
      margin-bottom: 12px;
    }

    .section-intro {
      text-align: center;
      max-width: 780px;
      margin: 0 auto 35px;
      color: #596a7d;
    }

    .about {
      background: var(--light);
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 22px;
      margin-top: 30px;
    }

    .card {
      background: var(--white);
      padding: 27px;
      border-radius: 12px;
      box-shadow: 0 5px 22px #12345612;
      border: 1px solid #e6edf5;
    }

    .card .symbol {
      font-size: 35px;
      margin-bottom: 10px;
    }

    .card h3 {
      color: var(--primary);
      margin-bottom: 12px;
    }

    .card p {
      color: #596a7d;
      margin-bottom: 15px;
    }

    .highlight {
      background: #eaf4ff;
      border-left: 5px solid var(--secondary);
      padding: 22px;
      border-radius: 6px;
      margin-top: 25px;
    }

    .steps {
      padding-left: 22px;
    }

    .steps li {
      margin: 10px 0;
    }

    .careers {
      background: var(--light);
    }

    form {
      max-width: 750px;
      margin: 25px auto 0;
      background: var(--white);
      padding: 28px;
      border-radius: 12px;
      box-shadow: 0 5px 22px #12345612;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .field {
      margin-bottom: 16px;
    }

    .field.full {
      grid-column: 1 / -1;
    }

    label {
      display: block;
      font-weight: bold;
      margin-bottom: 6px;
    }

    input, select, textarea {
      width: 100%;
      padding: 12px;
      border: 1px solid #ccd7e4;
      border-radius: 6px;
      font: inherit;
    }

    textarea {
      min-height: 110px;
      resize: vertical;
    }

    .form-note {
      font-size: 13px;
      color: #596a7d;
      margin: 12px 0;
    }

    .form-status {
      margin-top: 14px;
      font-weight: bold;
      overflow-wrap: anywhere;
    }

    .contact {
      background: var(--primary);
      color: var(--white);
    }

    .contact .section-title {
      color: var(--white);
    }

    .contact .section-intro {
      color: #e1edff;
    }

    .contact-box {
      max-width: 800px;
      margin: auto;
      text-align: center;
    }

    .contact-box a {
      color: var(--white);
    }

    footer {
      padding: 25px 7%;
      background: #06284f;
      color: var(--white);
      text-align: center;
      font-size: 14px;
    }

    footer a {
      color: var(--white);
    }

    .disclaimer {
      font-size: 13px;
      color: #68798b;
      margin-top: 22px;
    }

    [hidden] {
      display: none !important;
    }

    @media (max-width: 760px) {
      header {
        position: static;
      }

      nav {
        width: 100%;
        gap: 12px;
      }

      nav a {
        font-size: 13px;
      }

      .hero {
        padding: 60px 7%;
      }

      section {
        padding: 45px 6%;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .field.full {
        grid-column: auto;
      }

      form {
        padding: 20px;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="logo">
    Shaping Future
    <small>MICROFINANCE PVT. LTD.</small>
  </div>

  <nav aria-label="Main navigation">
    <a href="#home" data-en="Home" data-hi="होम">Home</a>
    <a href="#about" data-en="About Us" data-hi="हमारे बारे में">About Us</a>
    <a href="#services" data-en="Services" data-hi="सेवाएँ">Services</a>
    <a href="#shg" data-en="SHG & Loans" data-hi="एसएचजी और ऋण">SHG & Loans</a>
    <a href="#careers" data-en="Careers" data-hi="करियर">Careers</a>
    <a href="#contact" data-en="Contact" data-hi="संपर्क">Contact</a>
    <button class="lang-btn" id="languageButton"
            type="button" onclick="toggleLanguage()">
      हिन्दी
    </button>
  </nav>
</header>

<main>

  <!-- HOME -->
  <section class="hero" id="home">
    <div class="hero-content">
      <h1 data-en="Empowering Communities. Shaping a Better Future."
          data-hi="समुदायों को सशक्त बनाना, बेहतर भविष्य बनाना।">
        Empowering Communities. Shaping a Better Future.
      </h1>

      <p data-en="Supporting financial awareness, community development and responsible financial inclusion through a people-focused approach."
         data-hi="लोगों को केंद्र में रखकर वित्तीय जागरूकता, सामुदायिक विकास और जिम्मेदार वित्तीय समावेशन को बढ़ावा देना।">
        Supporting financial awareness, community development and
        responsible financial inclusion through a people-focused approach.
      </p>

      <a class="btn btn-light" href="#about"
         data-en="Explore Our Company" data-hi="हमारी कंपनी जानें">
        Explore Our Company
      </a>

      <a class="btn btn-primary" href="#contact"
         data-en="Contact Us" data-hi="संपर्क करें">
        Contact Us
      </a>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about" id="about">
    <h2 class="section-title"
        data-en="About Shaping Future"
        data-hi="शेपिंग फ्यूचर के बारे में">
      About Shaping Future
    </h2>

    <p class="section-intro"
       data-en="We aim to support communities with accessible information, transparent communication and responsible financial practices."
       data-hi="हम सुलभ जानकारी, पारदर्शी संवाद और जिम्मेदार वित्तीय प्रक्रियाओं के माध्यम से समुदायों को सहयोग देने का उद्देश्य रखते हैं।">
      We aim to support communities with accessible information,
      transparent communication and responsible financial practices.
    </p>

    <div class="cards">
      <article class="card">
        <div class="symbol">🎯</div>
        <h3 data-en="Our Mission" data-hi="हमारा मिशन">Our Mission</h3>
        <p data-en="To encourage financial awareness, responsible decisions and community participation."
           data-hi="वित्तीय जागरूकता, जिम्मेदार निर्णय और सामुदायिक भागीदारी को प्रोत्साहित करना।">
          To encourage financial awareness, responsible decisions
          and community participation.
        </p>
      </article>

      <article class="card">
        <div class="symbol">🤝</div>
        <h3 data-en="Our Approach" data-hi="हमारा दृष्टिकोण">Our Approach</h3>
        <p data-en="We value transparency, respectful service, accountability and clear communication."
           data-hi="हम पारदर्शिता, सम्मानजनक सेवा, जवाबदेही और स्पष्ट संवाद को महत्व देते हैं।">
          We value transparency, respectful service, accountability
          and clear communication.
        </p>
      </article>

      <article class="card">
        <div class="symbol">🌱</div>
        <h3 data-en="Community Development" data-hi="सामुदायिक विकास">
          Community Development
        </h3>
        <p data-en="We seek to promote financial literacy and community-led development."
           data-hi="हम वित्तीय साक्षरता और समुदाय के नेतृत्व वाले विकास को बढ़ावा देना चाहते हैं।">
          We seek to promote financial literacy and community-led development.
        </p>
      </article>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services">
    <h2 class="section-title"
        data-en="Our Services" data-hi="हमारी सेवाएँ">
      Our Services
    </h2>

    <p class="section-intro"
       data-en="Explore our community and financial-service information. Actual products, eligibility and terms must be confirmed with the company."
       data-hi="हमारी सामुदायिक और वित्तीय सेवाओं की जानकारी देखें। वास्तविक उत्पादों, पात्रता और शर्तों की पुष्टि कंपनी से करें।">
      Explore our community and financial-service information.
      Actual products, eligibility and terms must be confirmed with the company.
    </p>

    <div class="cards">
      <article class="card">
        <div class="symbol">👥</div>
        <h3 data-en="SHG Support" data-hi="एसएचजी सहयोग">SHG Support</h3>
        <p data-en="Information about Self-Help Groups, group participation and financial awareness."
           data-hi="स्वयं सहायता समूहों, समूह में भागीदारी और वित्तीय जागरूकता की जानकारी।">
          Information about Self-Help Groups, group participation
          and financial awareness.
        </p>
        <a href="#shg" data-en="Learn More" data-hi="और जानें">Learn More</a>
      </article>

      <article class="card">
        <div class="symbol">💳</div>
        <h3 data-en="Loan Information" data-hi="ऋण संबंधी जानकारी">
          Loan Information
        </h3>
        <p data-en="Understand application steps, eligibility checks, repayment obligations and terms."
           data-hi="आवेदन प्रक्रिया, पात्रता जाँच, पुनर्भुगतान की जिम्मेदारियों और शर्तों को समझें।">
          Understand application steps, eligibility checks,
          repayment obligations and terms.
        </p>
        <a href="#shg" data-en="Learn More" data-hi="और जानें">Learn More</a>
      </article>

      <article class="card">
        <div class="symbol">📚</div>
        <h3 data-en="Financial Awareness" data-hi="वित्तीय जागरूकता">
          Financial Awareness
        </h3>
        <p data-en="Learn about budgeting, saving habits, responsible borrowing and fraud prevention."
           data-hi="बजट, बचत की आदतों, जिम्मेदार उधार और धोखाधड़ी से बचाव के बारे में जानें।">
          Learn about budgeting, saving habits, responsible borrowing
          and fraud prevention.
        </p>
      </article>

      <article class="card">
        <div class="symbol">💼</div>
        <h3 data-en="Career Opportunities" data-hi="नौकरी के अवसर">
          Career Opportunities
        </h3>
        <p data-en="Explore opportunities in field operations, member services and administration."
           data-hi="फील्ड ऑपरेशंस, सदस्य सेवाओं और प्रशासन में अवसरों की जानकारी पाएँ।">
          Explore opportunities in field operations, member services
          and administration.
        </p>
        <a href="#careers" data-en="Apply Now" data-hi="आवेदन करें">Apply Now</a>
      </article>
    </div>
  </section>

  <!-- SHG & LOANS -->
  <section class="about" id="shg">
    <h2 class="section-title"
        data-en="SHG & Loan Process" data-hi="एसएचजी और ऋण प्रक्रिया">
      SHG & Loan Process
    </h2>

    <p class="section-intro"
       data-en="General information to help applicants understand the process. Final eligibility and approval depend on company policy and applicable regulations."
       data-hi="आवेदकों को प्रक्रिया समझाने के लिए सामान्य जानकारी। अंतिम पात्रता और स्वीकृति कंपनी की नीति और लागू नियमों पर निर्भर करेगी।">
      General information to help applicants understand the process.
      Final eligibility and approval depend on company policy and applicable regulations.
    </p>

    <div class="cards">
      <article class="card">
        <h3 data-en="1. Enquiry" data-hi="1. पूछताछ">1. Enquiry</h3>
        <p data-en="Contact the company to learn about available services and service locations."
           data-hi="उपलब्ध सेवाओं और सेवा क्षेत्रों की जानकारी के लिए कंपनी से संपर्क करें।">
          Contact the company to learn about available services and service locations.
        </p>
      </article>

      <article class="card">
        <h3 data-en="2. Eligibility Review" data-hi="2. पात्रता की जाँच">
          2. Eligibility Review
        </h3>
        <p data-en="The company may review applicant information and required documents according to its policy."
           data-hi="कंपनी अपनी नीति के अनुसार आवेदक की जानकारी और आवश्यक दस्तावेजों की जाँच कर सकती है।">
          The company may review applicant information and required documents
          according to its policy.
        </p>
      </article>

      <article class="card">
        <h3 data-en="3. Terms & Decision" data-hi="3. शर्तें और निर्णय">
          3. Terms & Decision
        </h3>
        <p data-en="Review all charges, interest, repayment terms and documents before accepting any offer."
           data-hi="किसी भी प्रस्ताव को स्वीकार करने से पहले सभी शुल्क, ब्याज, पुनर्भुगतान शर्तें और दस्तावेज़ पढ़ें।">
          Review all charges, interest, repayment terms and documents
          before accepting any offer.
        </p>
      </article>
    </div>

    <div class="highlight">
      <strong data-en="Important Notice" data-hi="महत्वपूर्ण सूचना">
        Important Notice
      </strong>
      <p data-en="This website is for general information and does not guarantee a loan, deposit facility or financial return. Services will be offered only where legally permitted and after applicable approvals. Never pay an unofficial agent."
         data-hi="यह वेबसाइट सामान्य जानकारी के लिए है। यह ऋण, जमा सुविधा या वित्तीय लाभ की गारंटी नहीं देती। सेवाएँ केवल कानूनी अनुमति और आवश्यक स्वीकृतियों के बाद ही दी जाएँगी। किसी अनधिकृत एजेंट को भुगतान न करें।">
        This website is for general information and does not guarantee
        a loan, deposit facility or financial return. Services will be offered
        only where legally permitted and after applicable approvals.
        Never pay an unofficial agent.
      </p>
    </div>
  </section>

  <!-- CAREERS -->
  <section class="careers" id="careers">
    <h2 class="section-title"
        data-en="Careers at Shaping Future"
        data-hi="शेपिंग फ्यूचर में करियर">
      Careers at Shaping Future
    </h2>

    <p class="section-intro"
       data-en="Interested in joining our team? Submit your details for recruitment follow-up."
       data-hi="हमारी टीम से जुड़ना चाहते हैं? भर्ती संबंधी संपर्क के लिए अपनी जानकारी भेजें।">
      Interested in joining our team? Submit your details for recruitment follow-up.
    </p>

    <form id="careerForm" onsubmit="submitForm(event, 'career')">
      <div class="form-grid">
        <div class="field">
          <label for="jobName" data-en="Full Name" data-hi="पूरा नाम">
            Full Name
          </label>
          <input id="jobName" name="name" required maxlength="100"
                 autocomplete="name">
        </div>

        <div class="field">
          <label for="jobPhone" data-en="Mobile Number" data-hi="मोबाइल नंबर">
            Mobile Number
          </label>
          <input id="jobPhone" name="phone" required
                 type="tel" inputmode="tel"
                 pattern="[0-9+() -]{8,20}" maxlength="20">
        </div>

        <div class="field">
          <label for="jobEmail" data-en="Email Address" data-hi="ईमेल">
            Email Address
          </label>
          <input id="jobEmail" name="email" type="email" required
                 maxlength="150" autocomplete="email">
        </div>

        <div class="field">
          <label for="jobPosition" data-en="Position" data-hi="पद">
            Position
          </label>
          <select id="jobPosition" name="position" required>
            <option value="">Select Position</option>
            <option>Relationship Officer - SHG</option>
            <option>Field Officer</option>
            <option>HR / Administration</option>
            <option>Accounts / Finance</option>
            <option>Branch / Operations</option>
            <option>Other</option>
          </select>
        </div>

        <div class="field full">
          <label for="jobLocation" data-en="Preferred Location"
                 data-hi="पसंदीदा स्थान">
            Preferred Location
          </label>
          <input id="jobLocation" name="location" maxlength="150"
                 placeholder="e.g. Patna, Lucknow">
        </div>

        <div class="field full">
          <label for="jobMessage" data-en="Experience / Message"
                 data-hi="अनुभव / संदेश">
            Experience / Message
          </label>
          <textarea id="jobMessage" name="message" maxlength="2000"
                    placeholder="Briefly describe your experience"></textarea>
        </div>
      </div>

      <p class="form-note"
         data-en="Please do not submit Aadhaar, bank details or other sensitive documents through this form."
         data-hi="इस फॉर्म में आधार, बैंक विवरण या अन्य संवेदनशील दस्तावेज़ न भेजें।">
        Please do not submit Aadhaar, bank details or other sensitive documents
        through this form.
      </p>

      <button class="btn btn-primary" type="submit"
              data-en="Submit Application" data-hi="आवेदन भेजें">
        Submit Application
      </button>

      <p id="careerStatus" class="form-status" role="status"></p>
    </form>
  </section>

  <!-- CONTACT -->
  <section id="contact">
    <h2 class="section-title"
        data-en="Contact Us" data-hi="हमसे संपर्क करें">
      Contact Us
    </h2>

    <p class="section-intro"
       data-en="For general enquiries, company information and recruitment questions, contact our team."
       data-hi="सामान्य पूछताछ, कंपनी की जानकारी और भर्ती संबंधी प्रश्नों के लिए हमारी टीम से संपर्क करें।">
      For general enquiries, company information and recruitment questions,
      contact our team.
    </p>

    <form id="contactForm" onsubmit="submitForm(event, 'contact')">
      <div class="form-grid">
        <div class="field">
          <label for="contactName" data-en="Your Name" data-hi="आपका नाम">
            Your Name
          </label>
          <input id="contactName" name="name" required maxlength="100">
        </div>

        <div class="field">
          <label for="contactEmail" data-en="Email Address" data-hi="ईमेल">
            Email Address
          </label>
          <input id="contactEmail" name="email" type="email"
                 required maxlength="150">
        </div>

        <div class="field full">
          <label for="contactSubject" data-en="Enquiry Type"
                 data-hi="पूछताछ का प्रकार">
            Enquiry Type
          </label>
          <select id="contactSubject" name="subject" required>
            <option value="">Select an option</option>
            <option>General Enquiry</option>
