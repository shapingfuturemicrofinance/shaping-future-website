<script>
  /*
    IMPORTANT:
    Google Sheet integration is disabled until you add your
    deployed Google Apps Script Web App URL below.
  */
  const GOOGLE_SCRIPT_URL = "";

  let currentLanguage = "en";

  document.getElementById("year").textContent =
    new Date().getFullYear();

  function toggleLanguage() {
    currentLanguage = currentLanguage === "en" ? "hi" : "en";

    document.documentElement.lang = currentLanguage;

    document.querySelectorAll("[data-en][data-hi]").forEach(function(el) {
      el.textContent = el.getAttribute(
        "data-" + currentLanguage
      );
    });

    document.getElementById("languageButton").textContent =
      currentLanguage === "en" ? "हिन्दी" : "English";
  }

  async function submitForm(event, type) {
    event.preventDefault();

    const form = event.target;
    const status = document.getElementById(
      type === "career" ? "careerStatus" : "contactStatus"
    );

    if (!form.reportValidity()) return;

    if (!GOOGLE_SCRIPT_URL) {
      status.textContent =
        "Form is not connected yet. Please configure the Google Apps Script URL.";
      return;
    }

    const data = Object.fromEntries(new FormData(form).entries());

    data.formType = type;
    data.source = "Shaping Future Website";

    const submitButton = form.querySelector(
      'button[type="submit"]'
    );

    submitButton.disabled = true;
    status.textContent = "Submitting...";

    try {
      /*
        Apps Script Web Apps commonly accept this no-cors
        submission pattern. The browser cannot verify the server's
        response in no-cors mode, so success is not claimed here.
        Verify each submission in the Google Sheet.
      */
      await fetch(GOOGLE_SCRIPT_URL, {
        method: "POST",
        mode: "no-cors",
        headers: {
          "Content-Type": "text/plain;charset=utf-8"
        },
        body: JSON.stringify(data)
      });

      status.textContent =
        "Request sent. Please verify receipt with the company if needed.";

      form.reset();

    } catch (error) {
      status.textContent =
        "Submission could not be sent. Please email shapingfuture22@gmail.com.";

    } finally {
      submitButton.disabled = false;
    }
  }
</script>

