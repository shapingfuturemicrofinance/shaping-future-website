<script>

/* MOBILE MENU */

function toggleMenu(){

    document
    .getElementById("navLinks")
    .classList.toggle("active");

}


/* LOGIN */

function openLogin(event,type){

    event.preventDefault();

    document
    .getElementById("modalTitle")
    .innerText = type + " Login";

    document
    .getElementById("loginModal")
    .style.display = "flex";
}


function closeModal(){

    document
    .getElementById("loginModal")
    .style.display = "none";

}


window.onclick=function(event){

    let modal=document.getElementById("loginModal");

    if(event.target===modal){
        closeModal();
    }

}


/* CONTACT */

function sendEnquiry(event){

    event.preventDefault();

    alert(
        "Thank you for contacting Shaping Future Microfinance. " +
        "Please email us at shapingfuture22@gmail.com."
    );

}

